EXPERTBOARD_APP_PORT=8010
EXPERTBOARD_MYSQL_PORT=13307
EXPERTBOARD_MYSQL_DATABASE=expertboard
EXPERTBOARD_MYSQL_USER=expertboard
EXPERTBOARD_MYSQL_PASSWORD=expertboard_dev
EXPERTBOARD_MYSQL_ROOT_PASSWORD=expertboard_root_dev
PUBCASEFINDER_BASE_URL=http://localhost:8000

# Keycloak (dev-mode, single realm, seeded from keycloak/import/expertboard-realm.json)
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev

# These two must match the values baked into keycloak/import/expertboard-realm.json
# unless you also edit that file.
EXPERTBOARD_OIDC_CLIENT_ID=expertboard-app
EXPERTBOARD_OIDC_CLIENT_SECRET=changeme-in-dev

